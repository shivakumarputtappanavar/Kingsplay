<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/kg_pill_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/kg_widget_pill_bg"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="12dp"
    android:paddingTop="10dp"
    android:paddingEnd="14dp"
    android:paddingBottom="10dp">

    <FrameLayout
        android:id="@+id/kg_pill_play_box"
        android:layout_width="72dp"
        android:layout_height="72dp"
        android:background="@drawable/kg_play_circle">

        <ImageView
            android:id="@+id/kg_pill_play"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:layout_gravity="center"
            android:contentDescription="@null"
            android:src="@drawable/kg_ic_play_dark" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:contentDescription="@null"
                android:src="@drawable/kg_ic_crown" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="Kings Play"
                android:textColor="#FFCFCBE0"
                android:textSize="14sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/kg_pill_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Play your music"
            android:textColor="#FFFFFFFF"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/kg_pill_artist"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Kings Play"
            android:textColor="#FFB9B3D9"
            android:textSize="14sp" />
    </LinearLayout>

    <ImageView
        android:id="@+id/kg_pill_art"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:layout_marginStart="10dp"
        android:contentDescription="@null"
        android:scaleType="centerCrop"
        android:src="@drawable/kg_cover_default" />
</LinearLayout>